# Node
node_modules/
**/node_modules/

# Environment / Secret files
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!.env.production.example
!**/.env.production.example
# Generated PHP configs hold DB passwords and Razorpay keys
**/db_config.php
**/payment_config.php

# Logs
*.log
**/logs/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build and IDE files
dist/
build/
.vercel/
**/dist/
**/build/
**/.vercel/
.idea/
.vscode/
.vs/
coverage/
.DS_Store
Thumbs.db

# Deployment packages built by the Store Builder (rebuild them; never commit)
*.zip
deployment/published/
zkc/deployment/published/
zkc/deployment/db-migrations/
zkc/deployment/*-godaddy-deploy*/
zkc/deployment/smeram-godaddy/
zkc/deployment/smeram/
zkc/deployment/scripts/temp-ftp-upload.ps1

# Merchant uploads are store data, not source
zkc/assets/uploads/
uploads/temp/

# Backups
*.bak

# zkc-build/ is generated from zkc/ by `npm run release:sync` — commit it, never edit it by hand.

deployment/smeram-godaddy/
deployment/*.zip

zkc/deployment/smeram-api/
zkc-build/deployment/smeram-api/
deployment/smeram-api/
