# Local development settings. Copy to .env; npm run dev uses this file.
NODE_ENV=development
PORT=3000

# Neon PostgreSQL — paste URL value only (no KEY= prefix)
#DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-host.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:Admin@123@localhost:5432/zkcommerce_v42

# JWT — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_char_secret_here

# Razorpay (test keys from razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudflare R2 (for image/file uploads)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key
R2_BUCKET=zkcommerce-production
R2_PUBLIC_URL=https://cdn.zkcommerce.in

# Gupshup WhatsApp
GUPSHUP_API_KEY=your_gupshup_key
GUPSHUP_APP_NAME=ZKCommerce
GUPSHUP_SOURCE_NUMBER=917xxxxxxxxx


# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxx
FROM_EMAIL=noreply@zkcommerce.in

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret


 ── Sentry (Error monitoring) ─────────────────────────────────
SENTRY_DSN=

# ── Delhivery (Shipping) ──────────────────────────────────────
DELHIVERY_API_KEY=
DELHIVERY_BASE_URL=https://track.delhivery.com

# ── URLs ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
# Production settings belong in the hosting provider or .env.production.
# See .env.production.example. Do not copy production secrets into this file.

# Storefront routing: point *.zkcommerce.in and stores.zkcommerce.in to this app,
# and provision wildcard TLS. Custom domains must CNAME to stores.zkcommerce.in.
STORE_BASE_DOMAIN=zkcommerce.in
CRON_SECRET=

# ── Meta / Instagram Shop (v4.1) ─────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_CATALOGUE_ID=
META_ACCESS_TOKEN=

# ── BNPL Providers (v4.1) ─────────────────────────────────────
SIMPL_MERCHANT_ID=
SIMPL_SECRET=
LAZYPAY_MERCHANT_ID=
LAZYPAY_SECRET=
BAJAJ_PARTNER_ID=
BAJAJ_SECRET=
