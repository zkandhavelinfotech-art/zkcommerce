# ZKCommerce v4.1 — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────
# Choose ONE of these DATABASE_URL options:

# Option A — Neon Production (use for Railway staging/prod):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASS@ep-proud-rice-axslvoko.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B — Neon Dev branch (use for local dev pointing to Neon):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASS@ep-orange-hill-axb1j6l3-pooler.c-4.us-east-2.aws.neon.tech/zcommerce_dev?sslmode=require&channel_binding=require

# Option C — Local PostgreSQL (use for fully local dev):
DATABASE_URL=postgresql://postgres:Admin@123@localhost:5432/zkcommerce

# Keep separate names if you want both:
DATABASE_ProdURL=postgresql://neondb_owner:YOUR_PASS@ep-proud-rice-axslvoko.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_DevURL=postgresql://neondb_owner:YOUR_PASS@ep-orange-hill-axb1j6l3-pooler.c-4.us-east-2.aws.neon.tech/zcommerce_dev?sslmode=require

# ── JWT ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# ── Razorpay ─────────────────────────────────────────────────
# Get test keys from: razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ── Cloudflare R2 (product images) ───────────────────────────
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=zkcommerce-dev
R2_ENDPOINT=
R2_PUBLIC_URL=http://localhost:3000/uploads

# ── Email (Resend) ────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
FROM_EMAIL=noreply@zkcommerce.in
FROM_NAME=ZKCommerce

# ── WhatsApp (Gupshup) ───────────────────────────────────────
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=ZKCommerce
WHATSAPP_FROM=+919000012345

# ── Redis (Upstash for cloud, local redis for dev) ────────────
REDIS_URL=redis://localhost:6379

# ── Sentry (Error monitoring) ─────────────────────────────────
SENTRY_DSN=

# ── Delhivery (Shipping) ──────────────────────────────────────
DELHIVERY_API_KEY=
DELHIVERY_BASE_URL=https://track.delhivery.com

# ── URLs ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ── Meta / Instagram Shop (v4.1) ─────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_CATALOGUE_ID=
META_ACCESS_TOKEN=

# ── BNPL Providers (v4.1) ─────────────────────────────────────
SIMPL_MERCHANT_ID=
SIMPL_SECRET=
LAZYPAY_MERCHANT_ID=
LAZYPAY_SECRET=
BAJAJ_PARTNER_ID=
BAJAJ_SECRET=

# ── Cron security (v4.1) ──────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=REPLACE_WITH_STRONG_RANDOM_STRING

# ── Upstash QStash (for abandoned cart + recurring order crons) ─
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=REPLACE_WITH_QSTASH_TOKEN
