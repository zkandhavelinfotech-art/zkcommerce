# Local development settings. Copy to .env; npm run dev uses this file.
NODE_ENV=development
PORT=3000

# Neon PostgreSQL — paste URL value only (no KEY= prefix)
#DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-host.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:Admin@123@localhost:5432/zkcommerce_v42

# JWT — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_char_secret_here

# ── Razorpay Configuration (Dual Mode: Live & Test) ───────────
RAZORPAY_MODE=live

# Active Keys (Resolved to Live)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret

# Live Settings (Domain: smeram-naturals.in)
RAZORPAY_LIVE_KEY_ID=rzp_live_your_key_id
RAZORPAY_LIVE_KEY_SECRET=your_live_key_secret
RAZORPAY_LIVE_WEBHOOK_SECRET=your_live_webhook_secret
RAZORPAY_LIVE_DOMAIN=smeram-naturals.in
RAZORPAY_LIVE_WEBHOOK_URL=https://smeram-naturals.in/smeram-backend-api/api.php?route=payments/razorpay/webhook

# Test Settings (Domain: localhost:3000)
RAZORPAY_TEST_KEY_ID=rzp_test_your_key_id
RAZORPAY_TEST_KEY_SECRET=your_razorpaay_key_secret
RAZORPAY_TEST_WEBHOOK_SECRET=your_test_webhook_secret
RAZORPAY_TEST_DOMAIN=localhost:3000
RAZORPAY_TEST_WEBHOOK_URL=http://localhost:3000/api.php?route=payments/razorpay/webhook

# Cloudflare R2 (for image/file uploads)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY=your_access_key
R2_SECRET_KEY=your_secret_key
R2_BUCKET=zkcommerce-production
R2_PUBLIC_URL=https://cdn.zkcommerce.in

# Gupshup WhatsApp
GUPSHUP_API_KEY=your_gupshup_key
GUPSHUP_APP_NAME=ZKCommerce
GUPSHUP_SOURCE_NUMBER=917xxxxxxxxx


# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxx
FROM_EMAIL=noreply@zkcommerce.in

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret


 ── Sentry (Error monitoring) ─────────────────────────────────
SENTRY_DSN=

# ── Delhivery (Shipping) ──────────────────────────────────────
DELHIVERY_API_KEY=
DELHIVERY_BASE_URL=https://track.delhivery.com

# ── URLs ──────────────────────────────────────────────────────
# Page environment for zk-env.js (window.ZK): nodedev = this Node app. phpdev / prod come from the Publish portal.
ZK_ENV=nodedev
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3000/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
# Production settings belong in the hosting provider or .env.production.
# See .env.production.example. Do not copy production secrets into this file.

# Storefront routing: point *.zkcommerce.in and stores.zkcommerce.in to this app,
# and provision wildcard TLS. Custom domains must CNAME to stores.zkcommerce.in.
STORE_BASE_DOMAIN=zkcommerce.in
CRON_SECRET=

# ── Meta / Instagram Shop (v4.1) ─────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_CATALOGUE_ID=
META_ACCESS_TOKEN=

# ── BNPL Providers (v4.1) ─────────────────────────────────────
SIMPL_MERCHANT_ID=
SIMPL_SECRET=
LAZYPAY_MERCHANT_ID=
LAZYPAY_SECRET=
BAJAJ_PARTNER_ID=
BAJAJ_SECRET=
