# Copy to .env.production for a local production-mode run, or configure these
# values in the production hosting provider's secret/environment settings.
NODE_ENV=production

# The hosting provider supplies PORT for its internal HTTP listener.
# Do not set the public URL as PORT. The public URL is configured separately below.
DATABASE_URL=mysql://zkc_user:ZkCommercePass2026!@localhost:3306/zkcommerce_db
#DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace_with_a_long_random_secret

FRONTEND_URL=https://storebuilderapp.zkcommerce.in
API_URL=https://storebuilderapp.zkcommerce.in/api
STORE_BUILDER_HOST=storebuilderapp.zkcommerce.in
STORE_BASE_DOMAIN=zkcommerce.in

# Add live provider keys only in the production secret manager.
# ════════════════════════════════════════════════════════════════
# RAZORPAY CONFIGURATION (Switch between Test & Live Mode)
# ════════════════════════════════════════════════════════════════

# 👉 TOGGLE MODE: Change to 'live' when you want to take real payments, or 'test' for testing!
RAZORPAY_MODE=test

# --- TEST KEYS ---
RAZORPAY_Test_KEY_ID=rzp_test_TryQ4PdsrTEyBB
RAZORPAY_Test_KEY_SECRET=SZfOuock8WVvSdxy2f5Uvrb5

# --- LIVE KEYS (Paste your real live keys here) ---
RAZORPAY_Live_KEY_ID=rzp_live_your_live_key_here
RAZORPAY_Live_KEY_SECRET=your_live_secret_here

# Optional: Webhook Secret
RAZORPAY_WEBHOOK_SECRET=SZfOuock8WVvSdxy2f5Uvrb5
