# ════════════════════════════════════════════════════════════════
# ZKCommerce v4.1 — Production Environment Configuration
# Copy this file to .env or set in GoDaddy / Cloud Hosting
# ════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3000

# ════════════════════════════════════════════════════════════════
# 1. DATABASE CONFIGURATION (Switch between MySQL & PostgreSQL)
# ════════════════════════════════════════════════════════════════
# Option A — GoDaddy MySQL (Active):
DATABASE_URL=mysql://zkc_user:ZkCommercePass2026!@localhost:3306/zkcommerce_db

# Option B — PostgreSQL / Neon (Uncomment when upgrading to Postgres):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-proud-rice-axslvoko.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require

# ════════════════════════════════════════════════════════════════
# 2. RAZORPAY CONFIGURATION (Switch between Test & Live Mode)
# ════════════════════════════════════════════════════════════════
# Set mode to 'test' or 'live'. The backend automatically picks the matching keys!
RAZORPAY_MODE=test

# --- TEST KEYS ---
RAZORPAY_Test_KEY_ID=rzp_test_TryQ4PdsrTEyBB
RAZORPAY_Test_KEY_SECRET=SZfOuock8WVvSdxy2f5Uvrb5

# --- LIVE KEYS (Paste your live keys from Razorpay Dashboard when going live) ---
RAZORPAY_Live_KEY_ID=rzp_live_your_live_key_here
RAZORPAY_Live_KEY_SECRET=your_live_secret_here

# Webhook Secret (optional, for webhooks)
RAZORPAY_WEBHOOK_SECRET=SZfOuock8WVvSdxy2f5Uvrb5

# ════════════════════════════════════════════════════════════════
# 3. SECURITY & AUTHENTICATION
# ════════════════════════════════════════════════════════════════
JWT_SECRET=zkcommerce_strong_production_secret_key_minimum_32_characters_2026
JWT_EXPIRES_IN=7d

# ════════════════════════════════════════════════════════════════
# 4. EMAIL (Resend or SMTP)
# ════════════════════════════════════════════════════════════════
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key
FROM_EMAIL=noreply@zkcommerce.in
FROM_NAME=ZKCommerce

# ════════════════════════════════════════════════════════════════
# 5. URLS
# ════════════════════════════════════════════════════════════════
FRONTEND_URL=https://zkcommerce.in
API_URL=https://api.zkcommerce.in
