{
  "name": "zkcommerce-api",
  "version": "4.1.0",
  "description": "ZKCommerce v4.1 Production API — ZKanadavel Infotech",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "dev": "nodemon api/server.js",
    "db:migrate": "psql $DATABASE_URL -f database/schema.sql && psql $DATABASE_URL -f database/phase1-additions.sql && psql $DATABASE_URL -f database/phase2-additions.sql && psql $DATABASE_URL -f database/phase3-additions.sql",
    "db:seed": "psql $DATABASE_URL -f database/phase3-additions.sql",
    "test": "jest --coverage",
    "lint": "eslint api/",
    "build": "echo 'No build step for API'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "razorpay": "^2.9.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
