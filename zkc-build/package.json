{
  "name": "zkcommerce-api",
  "version": "4.1.0",
  "description": "ZKCommerce v4.1 Production API \u2014 ZKanadavel Infotech",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "dev": "nodemon api/server.js",
    "db:migrate": "node deployment/scripts/neon-migrate.js",
    "db:seed": "psql $DATABASE_URL -f database/phase3-additions.sql",
    "test": "jest --coverage",
    "lint": "eslint api/",
    "build": "echo 'No build step for API'",
    "deploy": "node deployment/launcher.js deploy",
    "deploy:dev": "node deployment/launcher.js deploy development",
    "deploy:staging": "node deployment/launcher.js deploy staging",
    "deploy:prod": "node deployment/launcher.js deploy production",
    "health": "node deployment/launcher.js health development",
    "health:dev": "node deployment/launcher.js health development",
    "health:staging": "node deployment/launcher.js health staging",
    "health:prod": "node deployment/launcher.js health production",
    "db:create": "node deployment/launcher.js db:create",
    "db:backup": "node deployment/launcher.js db:backup",
    "db:reset": "node deployment/launcher.js db:reset",
    "db:status": "node deployment/launcher.js db:status",
    "status": "node deployment/launcher.js status",
    "docker:up": "docker-compose -f deployment/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f deployment/docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f deployment/docker/docker-compose.yml logs -f api",
    "docker:build": "docker build -f Dockerfile -t zkcommerce-api:latest .",
    "db:migrate:dev": "node deployment/scripts/neon-migrate.js",
    "db:migrate:neon": "node deployment/scripts/neon-migrate.js",
    "cron:abandoned": "curl -X POST http://localhost:3000/api/cron/abandoned-carts -H 'x-cron-secret: '${CRON_SECRET}",
    "cron:recurring": "curl -X POST http://localhost:3000/api/cron/recurring-orders -H 'x-cron-secret: '${CRON_SECRET}",
    "meta:sync": "node -e \"require('http').request({hostname:'localhost',port:3000,path:'/api/meta/sync',method:'POST'},r=>r.pipe(process.stdout)).end()\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "razorpay": "^2.9.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "ZKanadavel Infotech Pvt Ltd & ZK Infotech INC",
  "license": "PROPRIETARY"
}