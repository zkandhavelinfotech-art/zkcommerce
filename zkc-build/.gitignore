# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*

# Environment files — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.staging.local
.env.production.local
deployment/environments/.env.development
deployment/environments/.env.testing
deployment/environments/.env.staging
deployment/environments/.env.production

# Keep .env.example in git (safe — no real secrets)
!.env.example
!deployment/environments/.env.example

# Logs
deployment/logs/*.log
*.log

# Backups
deployment/backups/*.sql
deployment/backups/*.gz

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Certificates
deployment/certificates/*.pem
deployment/certificates/*.crt
deployment/certificates/*.key

# Build
dist/
build/
.next/
