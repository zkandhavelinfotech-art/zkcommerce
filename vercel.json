{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "zkc-build/dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.zkcommerce.in/api/:path*" },
    { "source": "/login", "destination": "/auth/login.html" },
    { "source": "/register", "destination": "/auth/register.html" },
    { "source": "/dashboard", "destination": "/merchant/dashboard.html" },
    { "source": "/admin", "destination": "/admin/dashboard.html" },
    { "source": "/checkout", "destination": "/storefront/checkout.html" },
    { "source": "/cart", "destination": "/storefront/cart.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
